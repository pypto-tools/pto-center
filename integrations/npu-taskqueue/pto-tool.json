{
  "apiVersion": "pto-center/v1",
  "id": "npu-taskqueue",
  "source": {
    "type": "git",
    "repository": "pypto-tools/pto-center"
  },
  "adapter": "adapter.py",
  "capabilities": [
    "probe"
  ],
  "actions": [
    {
      "id": "custom.queue-status",
      "title": "查看队列摘要",
      "effect": "read",
      "supportsBatch": true
    },
    {
      "id": "custom.usage-report",
      "title": "查看 NPU 使用统计",
      "effect": "read",
      "supportsBatch": true,
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "days": {
            "type": "integer",
            "title": "最近多少天",
            "minimum": 1,
            "maximum": 30,
            "default": 7
          }
        },
        "required": [
          "days"
        ]
      }
    }
  ]
}
