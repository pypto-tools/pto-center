{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "id",
    "source",
    "adapter",
    "capabilities"
  ],
  "properties": {
    "apiVersion": {
      "const": "pto-center/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "repository"
      ],
      "properties": {
        "type": {
          "const": "git"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+$"
        }
      }
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "contains": {
        "const": "probe"
      },
      "items": {
        "enum": [
          "probe",
          "update",
          "install",
          "activate",
          "rollback",
          "read-config",
          "validate-config",
          "apply-config"
        ]
      }
    },
    "configSchema": {
      "type": "string",
      "minLength": 1
    },
    "configSchemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "effect",
          "supportsBatch"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^custom[.][a-z][a-z0-9-]{0,62}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "effect": {
            "enum": [
              "read",
              "change"
            ]
          },
          "supportsBatch": {
            "type": "boolean"
          },
          "inputSchema": {
            "type": "object"
          }
        }
      }
    }
  },
  "dependentRequired": {
    "configSchema": [
      "configSchemaVersion"
    ],
    "configSchemaVersion": [
      "configSchema"
    ]
  }
}
